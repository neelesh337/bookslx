# Base URL of the BooksLX backend API.
# - Local dev: leave unset — Vite proxies /api to http://localhost:5000 (vite.config.ts).
# - Production (Vercel): set to your deployed Render backend:
#   https://bookslx.onrender.com/api
# If unset in a production build, the code defaults to https://bookslx.onrender.com/api.
VITE_API_URL=https://bookslx.onrender.com/api
