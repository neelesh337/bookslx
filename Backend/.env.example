PORT=5000
DATABASE_URL="file:./dev.db"
JWT_SECRET="bookslx_super_secret_jwt_key_2026_dev"
JWT_EXPIRES_IN="7d"
FRONTEND_URL="http://localhost:5173"

PAYMENT_MODE=mock
PAYMENT_ENV=test
PAYMENT_KEY="mock_key_bookslx"
PAYMENT_SECRET="mock_secret_bookslx"

# Razorpay test keys — free from https://dashboard.razorpay.com (Test Mode, no KYC)
# Set PAYMENT_MODE=razorpay to enable real test-card checkout.
RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxxxxxx"
RAZORPAY_KEY_SECRET="xxxxxxxxxxxxxxxxxxxxxxxx"
RAZORPAY_WEBHOOK_SECRET=""

LOGISTICS_MODE=mock
LOGISTICS_API_KEY="mock_logistics_key"
LOGISTICS_API_SECRET="mock_logistics_secret"

# Shiprocket real logistics (India) — free test account at https://app.shiprocket.in/register
# 1. Panel -> Settings -> API -> Add New API User (email + password, distinct from login)
# 2. Set LOGISTICS_MODE=shiprocket; LOGISTICS_API_KEY = API-user EMAIL, LOGISTICS_API_SECRET = API-user PASSWORD
# 3. Register a pickup location in the panel (Settings -> Pickup Locations) and set its name below if not "default"
# 4. Optional webhook security token (Panel -> Settings -> API -> Webhooks) -> sent as x-api-key header
#    Register webhook URL: https://<your-host>/api/logistics/webhook/shiprocket
# LOGISTICS_MODE=shiprocket
# LOGISTICS_API_KEY="your-api-user-email@example.com"
# LOGISTICS_API_SECRET="your-api-user-password"
# LOGISTICS_PICKUP_LOCATION="default"
# LOGISTICS_WEBHOOK_KEY=""
